        <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>

        <texture name="texplane_geom" type="cube" mark="cross" builtin="flat" markrgb="0.9 0.9 0.9" rgb1="0.50 0.50 0.50" rgb2="0.50 0.50 0.50" width="512" height="512"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1="0.50 0.50 0.50" rgb2="0.51 0.51 0.51" width="512" height="512"/>
        <material name="MatPlane" reflectance="0.0" shininess="0.0" specular="0.0" texrepeat="60 10" texture="texplane" />
        
        <material name="geom" texture="texgeom" texuniform="true"/>
        <material name="geom2" texture="texplane" texuniform="true"/>
        <material name="geom3" texture="texplane_geom" texuniform="true" rgba="0.5 0.5 0.5 1"/>
