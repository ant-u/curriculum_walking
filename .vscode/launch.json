{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
         {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "train as module",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.train",
            "cwd": "${workspaceFolder}",
            "args": "${command:pickArgs}",
            "justMyCode": false
        },
        {
            "name": "cvar as module",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.cvar_eval",
            "cwd": "${workspaceFolder}",
            "args": "${command:pickArgs}",
            "justMyCode": false
        },
        {
            "name": "train as module with base_lidar_gait_height_resistant",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.train",
            "cwd": "${workspaceFolder}",
            "args": "-t runs/base_lidar_gait_height_resistant",
            "justMyCode": false
        },
        {
            "name": "view_vec_env as module",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.view_vec_env",
            "cwd": "${workspaceFolder}",
            "args": "${command:pickArgs}"
        },
        {
            "name": "view_vec_env with best_model",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.view_vec_env",
            "cwd": "${workspaceFolder}",
            "args": "runs/base_lidar_gait_height_resistant"
        },
        {
            "name": "humanoid_curr as module",
            "type": "debugpy",
            "request": "launch",
            "module": "envs.humanoid_curr",
            "cwd": "${workspaceFolder}"
        }
    ]
}